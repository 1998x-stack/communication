{
  "schemaVersion": 2,
  "id": "collaboration-009",
  "category": "collaboration",
  "title": "明确验收条件",
  "level": 9,
  "difficulty": "low",
  "background": "开发声称功能已经完成。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "验收标准尚未书面确认"
  ],
  "objective": "按双方确认的清单逐项验收",
  "method": "Closed-loop / RACI",
  "pillars": [
    "目标一致",
    "责任清晰",
    "执行闭环"
  ],
  "steps": [
    {
      "name": "目标一致",
      "instruction": "开场先围绕已知事实“验收标准尚未书面确认”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "责任清晰",
      "instruction": "听到“还要测什么？”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "执行闭环",
      "instruction": "遭遇“谁决定验收通过？”的再次追问后，争取一个明确落点：“按双方确认的清单逐项验收”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "功能能跑不就是做完了吗？"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "目标一致",
      "text": "功能能跑是开发完成的信号，但目前验收标准还没书面确认，不能直接等同业务可用。我们需要先对齐通过条件。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "还要测什么？"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "责任清晰",
      "text": "至少要确认核心流程、边界情况和失败时的处理是否符合需求，不是为了多测而多测。可以用一页清单把项数控制住。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "谁决定验收通过？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "执行闭环",
      "text": "产品和需求方确认验收标准，开发提供证据，测试逐项核对；每项都有通过结论，未通过的列入修复清单。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "还要测什么？",
    "谁决定验收通过？"
  ],
  "coach": {
    "focus": "区分能运行与达到共同约定的验收标准。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
    "rubric": [
      {
        "name": "结构清楚",
        "weight": 25
      },
      {
        "name": "理解对方",
        "weight": 25
      },
      {
        "name": "坚定尊重",
        "weight": 25
      },
      {
        "name": "行动落点",
        "weight": 25
      }
    ]
  },
  "safetyNote": null,
