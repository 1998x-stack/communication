{
  "schemaVersion": 2,
  "id": "collaboration-010",
  "category": "collaboration",
  "title": "项目收尾致谢",
  "level": 10,
  "difficulty": "low",
  "background": "跨部门项目顺利结束。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "对方及时支援帮助项目提前交付"
  ],
  "objective": "共同整理成功做法和待改进点",
  "method": "Closed-loop / RACI",
  "pillars": [
    "目标一致",
    "责任清晰",
    "执行闭环"
  ],
  "steps": [
    {
      "name": "目标一致",
      "instruction": "开场先围绕已知事实“对方及时支援帮助项目提前交付”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "责任清晰",
      "instruction": "听到“你特意找我有什么事？”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "执行闭环",
      "instruction": "遭遇“经验要留在哪？”的再次追问后，争取一个明确落点：“共同整理成功做法和待改进点”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "这不是大家正常工作吗？"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "目标一致",
      "text": "提前交付确实是大家一起努力的结果。我想特别感谢你及时支援的那个环节，它让我们的依赖没有卡住。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "你特意找我有什么事？"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "责任清晰",
      "text": "没有额外需求，也不是客套。想跟你核对我们这次哪些配合最省时间，哪些仍有摩擦，给下次项目留些经验。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "经验要留在哪？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "执行闭环",
      "text": "我整理一页复盘：共享模板、响应机制和待改进点，发给相关负责人共同确认，以后类似项目可以直接复用。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "你特意找我有什么事？",
    "经验要留在哪？"
  ],
  "coach": {
    "focus": "具体致谢并沉淀可复制的协作经验。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
    "rubric": [
      {
        "name": "结构清楚",
        "weight": 25
      },
      {
        "name": "理解对方",
        "weight": 25
      },
      {
        "name": "坚定尊重",
        "weight": 25
      },
      {
        "name": "行动落点",
        "weight": 25
      }
    ]
  },
