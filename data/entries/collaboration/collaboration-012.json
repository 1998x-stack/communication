{
  "schemaVersion": 2,
  "id": "collaboration-012",
  "category": "collaboration",
  "title": "边界模糊的请求",
  "level": 12,
  "difficulty": "medium",
  "background": "同事长期把杂务推给你。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "该事项不在你的职责范围内"
  ],
  "objective": "将事务交回正确负责人并提供一次交接",
  "method": "Closed-loop / RACI",
  "pillars": [
    "目标一致",
    "责任清晰",
    "执行闭环"
  ],
  "steps": [
    {
      "name": "目标一致",
      "instruction": "开场先围绕已知事实“该事项不在你的职责范围内”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "责任清晰",
      "instruction": "听到“你做这个不是更熟吗？”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "执行闭环",
      "instruction": "遭遇“那现在谁来负责？”的再次追问后，争取一个明确落点：“将事务交回正确负责人并提供一次交接”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "帮一下有什么关系？"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "目标一致",
      "text": "偶尔帮忙当然没问题，但这个事项长期由我接手，而它不在我的岗位职责里，已经挤占了我的原任务。我们需要重新确认归属。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "你做这个不是更熟吗？"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "责任清晰",
      "text": "熟悉不等于应长期负责。我愿意把已积累的做法整理成操作说明，但后续排期和结果应由正式负责人承担。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "那现在谁来负责？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "执行闭环",
      "text": "今天先一起确认负责团队，我可以做一次交接并回答问题；交接完成后，新需求请直接走对应团队的入口。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "你做这个不是更熟吗？",
    "那现在谁来负责？"
  ],
  "coach": {
    "focus": "用一次性帮助换回长期职责边界。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
    "rubric": [
      {
        "name": "结构清楚",
        "weight": 25
      },
      {
        "name": "理解对方",
        "weight": 25
      },
      {
        "name": "坚定尊重",
        "weight": 25
      },
      {
        "name": "行动落点",
        "weight": 25
      }
    ]
  },
  "safetyNote": null,
