{
  "schemaVersion": 2,
  "id": "collaboration-014",
  "category": "collaboration",
  "title": "需求频繁反复",
  "level": 14,
  "difficulty": "medium",
  "background": "需求方一周改了四次范围。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "变动已导致两次开发返工"
  ],
  "objective": "建立变更记录与影响确认流程",
  "method": "Closed-loop / RACI",
  "pillars": [
    "目标一致",
    "责任清晰",
    "执行闭环"
  ],
  "steps": [
    {
      "name": "目标一致",
      "instruction": "开场先围绕已知事实“变动已导致两次开发返工”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "责任清晰",
      "instruction": "听到“你们就不能灵活一点？”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "执行闭环",
      "instruction": "遭遇“怎样保证下次不返工？”的再次追问后，争取一个明确落点：“建立变更记录与影响确认流程”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "改需求不是很正常吗？"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "目标一致",
      "text": "需求当然可能变化，但这周已经改了四次范围，造成两次开发返工。我们先对齐为什么要改，以及哪些变更必须现在做。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "你们就不能灵活一点？"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "责任清晰",
      "text": "我愿意支持业务变化，只是每次变动都需要知道代价。我们可以把影响分成工时、测试、交付日期三项，快速给你看取舍。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "怎样保证下次不返工？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "执行闭环",
      "text": "以后需求方提交变更时注明原因和优先级，由产品确认范围与影响，再通知开发和测试；紧急变更走加急流程并保留记录。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "你们就不能灵活一点？",
    "怎样保证下次不返工？"
  ],
  "coach": {
    "focus": "通过影响评估支持灵活变化，而不是简单拒绝。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
    "rubric": [
      {
        "name": "结构清楚",
        "weight": 25
      },
      {
        "name": "理解对方",
        "weight": 25
      },
      {
        "name": "坚定尊重",
        "weight": 25
      },
      {
        "name": "行动落点",
        "weight": 25
      }
    ]
  },
  "safetyNote": null,
