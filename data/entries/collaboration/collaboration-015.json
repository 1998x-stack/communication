{
  "schemaVersion": 2,
  "id": "collaboration-015",
  "category": "collaboration",
  "title": "团队资源冲突",
  "level": 15,
  "difficulty": "medium",
  "background": "两个同事争抢同一测试环境。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "环境同一时间只能支持一组回归"
  ],
  "objective": "共同排定测试环境时段和优先规则",
  "method": "Closed-loop / RACI",
  "pillars": [
    "目标一致",
    "责任清晰",
    "执行闭环"
  ],
  "steps": [
    {
      "name": "目标一致",
      "instruction": "开场先围绕已知事实“环境同一时间只能支持一组回归”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "责任清晰",
      "instruction": "听到“我们也有上线时间”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "执行闭环",
      "instruction": "遭遇“有没有公平的安排？”的再次追问后，争取一个明确落点：“共同排定测试环境时段和优先规则”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "为什么先给他们使用？"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "目标一致",
      "text": "不是偏向哪个团队，而是测试环境同一时间只能支撑一组回归。需要按业务时限和风险而非谁先争取来安排。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "我们也有上线时间"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "责任清晰",
      "text": "你们也有上线时间，我会把双方的最后可用时段、任务时长和风险都放在同一张表里，不让任何一方口头被压过去。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "有没有公平的安排？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "执行闭环",
      "text": "建议按紧急程度排时段，设交接点和超时提醒；如果两边都必须同一时间用，就请项目负责人决定谁先谁后。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "我们也有上线时间",
    "有没有公平的安排？"
  ],
  "coach": {
    "focus": "用公开规则分配稀缺资源，留下升级路径。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
    "rubric": [
      {
        "name": "结构清楚",
        "weight": 25
      },
      {
        "name": "理解对方",
        "weight": 25
      },
      {
        "name": "坚定尊重",
        "weight": 25
      },
      {
        "name": "行动落点",
        "weight": 25
      }
    ]
  },
  "safetyNote": null,
