{
  "schemaVersion": 2,
  "id": "collaboration-025",
  "category": "collaboration",
  "title": "对方拒绝负责",
  "level": 25,
  "difficulty": "high",
  "background": "关键任务无人认领。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "任务跨越两个部门职责边界"
  ],
  "objective": "根据流程确定唯一负责人并记录交付节点",
  "method": "Closed-loop / RACI",
  "pillars": [
    "目标一致",
    "责任清晰",
    "执行闭环"
  ],
  "steps": [
    {
      "name": "目标一致",
      "instruction": "开场先围绕已知事实“任务跨越两个部门职责边界”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "责任清晰",
      "instruction": "听到“你们也没说由我做”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "执行闭环",
      "instruction": "遭遇“要不一起找负责人？”的再次追问后，争取一个明确落点：“根据流程确定唯一负责人并记录交付节点”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "这本来就不是我的活"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "目标一致",
      "text": "这项任务确实跨两个部门边界，之前没有清楚分派，不能因为现在赶时间就把责任直接推给任何一个人。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "你们也没说由我做"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "责任清晰",
      "text": "你说之前没明确由你负责，这可能是流程问题。我会核对职责说明和交付链条，区分主责、配合和审批角色。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "要不一起找负责人？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "执行闭环",
      "text": "一起请两边负责人确认唯一主责人；今天先指定临时协调人避免停摆，并在共享计划记下任务节点与升级路径。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "你们也没说由我做",
    "要不一起找负责人？"
  ],
  "coach": {
    "focus": "承认原始分工模糊，由授权负责人明确唯一主责。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
    "rubric": [
      {
        "name": "结构清楚",
        "weight": 25
      },
      {
        "name": "理解对方",
        "weight": 25
      },
      {
        "name": "坚定尊重",
        "weight": 25
      },
      {
        "name": "行动落点",
        "weight": 25
      }
    ]
  },
