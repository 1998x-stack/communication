{
  "schemaVersion": 2,
  "id": "conflicts-002",
  "category": "conflicts",
  "title": "分担公共清洁",
  "level": 2,
  "difficulty": "low",
  "background": "合租室友不按约定清理厨房。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "公共台面两天没有清理"
  ],
  "objective": "明确轮值日与补做规则",
  "method": "Principled Negotiation / BATNA",
  "pillars": [
    "控制升级",
    "寻找真实利益",
    "建立可执行方案"
  ],
  "steps": [
    {
      "name": "控制升级",
      "instruction": "开场先围绕已知事实“公共台面两天没有清理”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "寻找真实利益",
      "instruction": "听到“又不是只有我弄脏”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "建立可执行方案",
      "instruction": "遭遇“轮值怎么定？”的再次追问后，争取一个明确落点：“明确轮值日与补做规则”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "我今天太累了"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "控制升级",
      "text": "我知道你今天很累，但厨房公共台面已经两天没有清理，影响了大家使用。我们先把现在这部分处理好，再商量轮值。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "又不是只有我弄脏"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "寻找真实利益",
      "text": "可能不只你一个人弄脏，所以更不能靠互相猜。我们可以按实际使用或固定轮班安排，谁有特殊情况提前换班。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "轮值怎么定？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "建立可执行方案",
      "text": "建议每人固定轮值日，没法当天做就在群里提前交换，漏做的次日补上；这周先试，再看是否公平。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "又不是只有我弄脏",
    "轮值怎么定？"
  ],
  "coach": {
    "focus": "从公共空间的实际影响切入，建立可交换的清洁轮值。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
