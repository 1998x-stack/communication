{
  "schemaVersion": 2,
  "id": "conflicts-004",
  "category": "conflicts",
  "title": "停车位误会",
  "level": 4,
  "difficulty": "low",
  "background": "同事把车停在你预约的位置。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "车位系统显示今天由你预订"
  ],
  "objective": "查看预约记录并调整停车",
  "method": "Principled Negotiation / BATNA",
  "pillars": [
    "控制升级",
    "寻找真实利益",
    "建立可执行方案"
  ],
  "steps": [
    {
      "name": "控制升级",
      "instruction": "开场先围绕已知事实“车位系统显示今天由你预订”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "寻找真实利益",
      "instruction": "听到“你有什么凭证？”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "建立可执行方案",
      "instruction": "遭遇“现在怎么解决？”的再次追问后，争取一个明确落点：“查看预约记录并调整停车”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "这不是谁先到谁停吗？"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "控制升级",
      "text": "这个车位系统显示今天由我预约，可能您没有看到预约信息。我们先查一下记录，避免只凭先到先停产生误会。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "你有什么凭证？"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "寻找真实利益",
      "text": "可以，我给您看预约编号与时段；如果系统显示的与你的不同，我们一起联系停车管理确认。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "现在怎么解决？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "建立可执行方案",
      "text": "核对后如果确实是我的时段，麻烦您把车调整到其他可用位；如果系统出错，我们请管理员协助找替代位。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "你有什么凭证？",
    "现在怎么解决？"
  ],
  "coach": {
    "focus": "用可验证的预约记录代替占位争执。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
    "rubric": [
      {
        "name": "结构清楚",
        "weight": 25
      },
      {
        "name": "理解对方",
        "weight": 25
      },
      {
        "name": "坚定尊重",
        "weight": 25
      },
      {
        "name": "行动落点",
        "weight": 25
      }
    ]
  },
  "safetyNote": null,
  "source": "https://www.pon.harvard.edu/daily/negotiation-skills-daily/principled-negotiation-focus-interests-create-value/",
