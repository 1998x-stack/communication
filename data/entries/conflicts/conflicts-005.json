{
  "schemaVersion": 2,
  "id": "conflicts-005",
  "category": "conflicts",
  "title": "聚餐谁付款",
  "level": 5,
  "difficulty": "low",
  "background": "朋友聚会结账时有人认为该你买单。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "本次聚餐没有事先说由谁请客"
  ],
  "objective": "核对以往约定并明确本次AA",
  "method": "Principled Negotiation / BATNA",
  "pillars": [
    "控制升级",
    "寻找真实利益",
    "建立可执行方案"
  ],
  "steps": [
    {
      "name": "控制升级",
      "instruction": "开场先围绕已知事实“本次聚餐没有事先说由谁请客”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "寻找真实利益",
      "instruction": "听到“你怎么这么会算？”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "建立可执行方案",
      "instruction": "遭遇“咱们按什么约定？”的再次追问后，争取一个明确落点：“核对以往约定并明确本次AA”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "上次不是我请了吗？"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "控制升级",
      "text": "上次谁请客可以另算，但这次聚餐没有提前约由谁买单，我没法默认由我请。先确认大家是否接受本次AA。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "你怎么这么会算？"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "寻找真实利益",
      "text": "我不是要把友情按每顿饭斤斤计较，而是事先没说谁请，结账时突然指定一个人会不舒服。我们可以以后轮流，但要提前讲清。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "咱们按什么约定？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "建立可执行方案",
      "text": "这次就按各自同意的AA规则核账；若有人单点明显不同的项目，再依明细调整。下次聚餐前说好请客或均摊方式。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "你怎么这么会算？",
    "咱们按什么约定？"
  ],
  "coach": {
    "focus": "避免临结账的情感压力，回到明确且可检查的约定。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
    "rubric": [
      {
        "name": "结构清楚",
        "weight": 25
      },
