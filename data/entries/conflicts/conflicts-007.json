{
  "schemaVersion": 2,
  "id": "conflicts-007",
  "category": "conflicts",
  "title": "被误解语气",
  "level": 7,
  "difficulty": "low",
  "background": "短信里的简短回复被认为是冷漠。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "当时正在开会只能简短回复"
  ],
  "objective": "澄清文字意图并约定重要事语音聊",
  "method": "Principled Negotiation / BATNA",
  "pillars": [
    "控制升级",
    "寻找真实利益",
    "建立可执行方案"
  ],
  "steps": [
    {
      "name": "控制升级",
      "instruction": "开场先围绕已知事实“当时正在开会只能简短回复”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "寻找真实利益",
      "instruction": "听到“你是不是不想聊？”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "建立可执行方案",
      "instruction": "遭遇“你真实想法是什么？”的再次追问后，争取一个明确落点：“澄清文字意图并约定重要事语音聊”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "你就回一个好字？"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "控制升级",
      "text": "当时正在开会，只能回一个“好”，不是想冷淡你。文字太短确实容易让人误解，抱歉让你不舒服。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "你是不是不想聊？"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "寻找真实利益",
      "text": "不是不想聊，而是那会儿没法认真回复。我可以在忙的时候明确说“现在不方便，稍后再聊”，而不让你猜我的态度。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "你真实想法是什么？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "建立可执行方案",
      "text": "我的真实想法是愿意继续谈那件事，只是需要完整时间。以后重要或容易误解的事情我们改语音或见面说，先确认各自的意思。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "你是不是不想聊？",
    "你真实想法是什么？"
  ],
  "coach": {
    "focus": "澄清文字语气，约定更适合复杂情绪的沟通渠道。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
    "rubric": [
      {
        "name": "结构清楚",
        "weight": 25
      },
      {
        "name": "理解对方",
        "weight": 25
      },
      {
        "name": "坚定尊重",
        "weight": 25
      },
      {
        "name": "行动落点",
        "weight": 25
      }
    ]
  },
