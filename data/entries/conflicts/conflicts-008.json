{
  "schemaVersion": 2,
  "id": "conflicts-008",
  "category": "conflicts",
  "title": "借用物品争执",
  "level": 8,
  "difficulty": "low",
  "background": "室友未经同意使用了你的相机。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "相机镜头比较昂贵且需要维护"
  ],
  "objective": "要求使用前先征得同意",
  "method": "Principled Negotiation / BATNA",
  "pillars": [
    "控制升级",
    "寻找真实利益",
    "建立可执行方案"
  ],
  "steps": [
    {
      "name": "控制升级",
      "instruction": "开场先围绕已知事实“相机镜头比较昂贵且需要维护”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "寻找真实利益",
      "instruction": "听到“你以前也借过我东西”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "建立可执行方案",
      "instruction": "遭遇“下次先问可以吗？”的再次追问后，争取一个明确落点：“要求使用前先征得同意”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "我以为你不会介意"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "控制升级",
      "text": "相机和镜头比较昂贵，也需要妥善维护。即使你觉得我不介意，使用前也应该先问我，不能直接拿走。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "你以前也借过我东西"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "寻找真实利益",
      "text": "以前我借过你的东西，如果当时没说清也可以讨论；但过去互相借用不代表今后所有私人物品都可以随时拿。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "下次先问可以吗？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "建立可执行方案",
      "text": "下次请先发消息问并确认归还时间，这次也请一起检查设备状况。有需要我可以告诉你正确的收纳和使用方式。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "你以前也借过我东西",
    "下次先问可以吗？"
  ],
  "coach": {
    "focus": "物品借用的关键是事先同意和损坏风险，而非追究谁更大方。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
    "rubric": [
      {
        "name": "结构清楚",
        "weight": 25
      },
