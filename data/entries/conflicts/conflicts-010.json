{
  "schemaVersion": 2,
  "id": "conflicts-010",
  "category": "conflicts",
  "title": "小组决策平票",
  "level": 10,
  "difficulty": "low",
  "background": "五人团队对方案投票出现分歧。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "目前方案争议涉及成本与安全性"
  ],
  "objective": "明确评价标准并请负责人决策",
  "method": "Principled Negotiation / BATNA",
  "pillars": [
    "控制升级",
    "寻找真实利益",
    "建立可执行方案"
  ],
  "steps": [
    {
      "name": "控制升级",
      "instruction": "开场先围绕已知事实“目前方案争议涉及成本与安全性”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "寻找真实利益",
      "instruction": "听到“投票也解决不了”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "建立可执行方案",
      "instruction": "遭遇“谁有最终拍板权？”的再次追问后，争取一个明确落点：“明确评价标准并请负责人决策”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "为什么非要按你的？"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "控制升级",
      "text": "我不要求按我的方案选。争议的关键是成本与安全性，我们需要先确认哪些安全条件不可妥协，再比较余下的成本。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "投票也解决不了"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "寻找真实利益",
      "text": "如果投票不能回答风险归属，单靠票数确实不够。团队应先明确评估标准和有权限最终承担决策的人。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "谁有最终拍板权？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "建立可执行方案",
      "text": "我们提交两案的成本、安全风险和必要证据给项目负责人，由其按既定权限拍板，并记录理由与后续验证点。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "投票也解决不了",
    "谁有最终拍板权？"
  ],
  "coach": {
    "focus": "平票时先明确安全门槛和决策权限，而非继续拉票。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
    "rubric": [
      {
        "name": "结构清楚",
        "weight": 25
      },
      {
        "name": "理解对方",
        "weight": 25
      },
      {
        "name": "坚定尊重",
        "weight": 25
      },
      {
        "name": "行动落点",
        "weight": 25
      }
    ]
  },
  "safetyNote": null,
