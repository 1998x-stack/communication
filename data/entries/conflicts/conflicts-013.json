{
  "schemaVersion": 2,
  "id": "conflicts-013",
  "category": "conflicts",
  "title": "共享资源分配",
  "level": 13,
  "difficulty": "medium",
  "background": "两个项目组都要使用同一会议室。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "会议室只有一个且双方都有既定参会人"
  ],
  "objective": "根据预约与实际紧急程度重新安排",
  "method": "Principled Negotiation / BATNA",
  "pillars": [
    "控制升级",
    "寻找真实利益",
    "建立可执行方案"
  ],
  "steps": [
    {
      "name": "控制升级",
      "instruction": "开场先围绕已知事实“会议室只有一个且双方都有既定参会人”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "寻找真实利益",
      "instruction": "听到“我们的客户更重要”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "建立可执行方案",
      "instruction": "遭遇“用什么规则决定？”的再次追问后，争取一个明确落点：“根据预约与实际紧急程度重新安排”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "我们先订的"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "控制升级",
      "text": "你们确实有先订的记录，另一组也有既定客户和参会人。我们先核对预约系统和各自不可移动的时间点，而不是争谁更重要。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "我们的客户更重要"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "寻找真实利益",
      "text": "客户重要性不是唯一标准。若原预约有效，应优先尊重；若存在冲突或紧急变更，需要有统一调整规则。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "用什么规则决定？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "建立可执行方案",
      "text": "先按预约记录安排，另一组优先找替代会议室或调整时段；若两边都不能变，由场地管理员按公开规则协调并通知参与者。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "我们的客户更重要",
    "用什么规则决定？"
  ],
  "coach": {
    "focus": "资源冲突先用预约与可替代性判断，不凭地位压人。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
    "rubric": [
      {
        "name": "结构清楚",
        "weight": 25
      },
      {
        "name": "理解对方",
        "weight": 25
      },
      {
        "name": "坚定尊重",
        "weight": 25
      },
      {
        "name": "行动落点",
        "weight": 25
      }
    ]
  },
  "safetyNote": null,
