{
  "schemaVersion": 2,
  "id": "conflicts-014",
  "category": "conflicts",
  "title": "合同责任争议",
  "level": 14,
  "difficulty": "medium",
  "background": "服务方和采购方各执一词。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "双方签署的版本可以核实"
  ],
  "objective": "共同核对条款并列出未解决事项",
  "method": "Principled Negotiation / BATNA",
  "pillars": [
    "控制升级",
    "寻找真实利益",
    "建立可执行方案"
  ],
  "steps": [
    {
      "name": "控制升级",
      "instruction": "开场先围绕已知事实“双方签署的版本可以核实”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "寻找真实利益",
      "instruction": "听到“合同里没写这个”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "建立可执行方案",
      "instruction": "遭遇“先看哪一条？”的再次追问后，争取一个明确落点：“共同核对条款并列出未解决事项”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "你们没按合同做"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "控制升级",
      "text": "我们对合同履行的理解不同，先别直接说哪方违约。双方签署版本可以核实，我们以同一份文件和交付记录为基础逐条看。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "合同里没写这个"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "寻找真实利益",
      "text": "有些要求可能写在附件或变更记录里，也可能没有约定。我们先核实条款编号、签署日期及任何双方确认的变更。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "先看哪一条？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "建立可执行方案",
      "text": "先核对服务范围、验收、付款和变更条款，把已一致与仍争议的事项分开列出，必要时由双方合同或法律人员继续评审。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "合同里没写这个",
    "先看哪一条？"
  ],
  "coach": {
    "focus": "合同争议先统一文件事实和问题清单，不用口头记忆代替条款。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
    "rubric": [
      {
        "name": "结构清楚",
        "weight": 25
      },
