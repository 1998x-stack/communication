{
  "schemaVersion": 2,
  "id": "conflicts-015",
  "category": "conflicts",
  "title": "被公开指责懒惰",
  "level": 15,
  "difficulty": "medium",
  "background": "团队聚会上有人说你总在偷懒。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "你的交付记录与指责不一致"
  ],
  "objective": "要求回到具体任务与结果",
  "method": "Principled Negotiation / BATNA",
  "pillars": [
    "控制升级",
    "寻找真实利益",
    "建立可执行方案"
  ],
  "steps": [
    {
      "name": "控制升级",
      "instruction": "开场先围绕已知事实“你的交付记录与指责不一致”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "寻找真实利益",
      "instruction": "听到“你还敢说自己没问题？”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "建立可执行方案",
      "instruction": "遭遇“用什么事实讨论？”的再次追问后，争取一个明确落点：“要求回到具体任务与结果”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "大家都看到了"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "控制升级",
      "text": "如果你认为我没有尽责，请指出具体哪项任务和交付结果。我愿意核对事实，但不接受在聚会上被笼统叫作“偷懒”。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "你还敢说自己没问题？"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "寻找真实利益",
      "text": "大家看到的可能是片段，我手里有可核对的任务记录。我们可以找合适的工作场合逐项核实，而不是在社交场合互相贬低。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "用什么事实讨论？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "建立可执行方案",
      "text": "请停止这种公开标签。若有真实绩效疑问，我们和负责人按交付记录讨论；今天不把聚会变成没有证据的指责。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "你还敢说自己没问题？",
    "用什么事实讨论？"
  ],
  "coach": {
    "focus": "面对公开羞辱，明确停止标签并转向正式事实核对。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
    "rubric": [
      {
        "name": "结构清楚",
        "weight": 25
      },
      {
        "name": "理解对方",
        "weight": 25
      },
      {
        "name": "坚定尊重",
        "weight": 25
      },
      {
        "name": "行动落点",
        "weight": 25
      }
    ]
  },
