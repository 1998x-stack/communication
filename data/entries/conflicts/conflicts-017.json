{
  "schemaVersion": 2,
  "id": "conflicts-017",
  "category": "conflicts",
  "title": "遇到情绪升级",
  "level": 17,
  "difficulty": "medium",
  "background": "双方讨论变成互相大声说话。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "双方已无法准确复述对方观点"
  ],
  "objective": "暂停十分钟并约定重新讨论",
  "method": "Principled Negotiation / BATNA",
  "pillars": [
    "控制升级",
    "寻找真实利益",
    "建立可执行方案"
  ],
  "steps": [
    {
      "name": "控制升级",
      "instruction": "开场先围绕已知事实“双方已无法准确复述对方观点”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "寻找真实利益",
      "instruction": "听到“现在必须说清楚”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "建立可执行方案",
      "instruction": "遭遇“什么时候继续谈？”的再次追问后，争取一个明确落点：“暂停十分钟并约定重新讨论”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "你别给我讲大道理"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "控制升级",
      "text": "我们已经开始互相提高音量，连对方刚才的意思都复述不准确。我建议先暂停十分钟，不在这种状态下继续下结论。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "现在必须说清楚"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "寻找真实利益",
      "text": "我知道你希望今天说清楚，我也愿意谈。但继续大声争论只会让双方误解更深，先停一下是为了能真正讨论。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "什么时候继续谈？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "建立可执行方案",
      "text": "十分钟后在同一地点继续，每个人先用一分钟复述对方最在意的点，再讨论一个具体问题；若仍无法平静就另约时间。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "现在必须说清楚",
    "什么时候继续谈？"
  ],
  "coach": {
    "focus": "明确短暂停止争吵的期限与重新开始的规则。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
    "rubric": [
      {
        "name": "结构清楚",
        "weight": 25
      },
      {
        "name": "理解对方",
        "weight": 25
      },
      {
        "name": "坚定尊重",
        "weight": 25
      },
      {
        "name": "行动落点",
        "weight": 25
      }
    ]
  },
