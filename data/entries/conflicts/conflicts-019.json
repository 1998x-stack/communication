{
  "schemaVersion": 2,
  "id": "conflicts-019",
  "category": "conflicts",
  "title": "被迫替人背锅",
  "level": 19,
  "difficulty": "medium",
  "background": "领导要你承担别人决策导致的问题。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "决策记录明确显示由其他人批准"
  ],
  "objective": "提供时间线并拒绝虚假责任归属",
  "method": "Principled Negotiation / BATNA",
  "pillars": [
    "控制升级",
    "寻找真实利益",
    "建立可执行方案"
  ],
  "steps": [
    {
      "name": "控制升级",
      "instruction": "开场先围绕已知事实“决策记录明确显示由其他人批准”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "寻找真实利益",
      "instruction": "听到“难道团队利益不重要？”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "建立可执行方案",
      "instruction": "遭遇“怎样把事实说清楚？”的再次追问后，争取一个明确落点：“提供时间线并拒绝虚假责任归属”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "你先把责任认了"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "控制升级",
      "text": "我愿意参与解决团队问题，但决策记录显示该事项由其他负责人批准。我不能为不属于自己的批准行为作虚假认责。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "难道团队利益不重要？"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "寻找真实利益",
      "text": "团队利益重要，真实复盘同样重要。如果我们故意改变责任归属，改进措施就会针对错误环节，之后还可能重犯。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "怎样把事实说清楚？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "建立可执行方案",
      "text": "我会提供完整时间线、自己的执行记录和当时的审批信息，承担确实由我负责的部分；请由正式负责人依据事实认定责任和整改。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "难道团队利益不重要？",
    "怎样把事实说清楚？"
  ],
  "coach": {
    "focus": "拒绝顶替他人决策责任，同时接受本人真实职责。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
    "rubric": [
      {
        "name": "结构清楚",
        "weight": 25
      },
      {
        "name": "理解对方",
        "weight": 25
      },
      {
        "name": "坚定尊重",
        "weight": 25
      },
      {
        "name": "行动落点",
        "weight": 25
      }
    ]
  },
