{
  "schemaVersion": 2,
  "id": "conflicts-021",
  "category": "conflicts",
  "title": "遭遇持续语言攻击",
  "level": 21,
  "difficulty": "high",
  "background": "对方反复用人格侮辱压制讨论。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "讨论已多次偏离具体问题"
  ],
  "objective": "明确停止侮辱并在必要时离开对话",
  "method": "Principled Negotiation / BATNA",
  "pillars": [
    "控制升级",
    "寻找真实利益",
    "建立可执行方案"
  ],
  "steps": [
    {
      "name": "控制升级",
      "instruction": "开场先围绕已知事实“讨论已多次偏离具体问题”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "寻找真实利益",
      "instruction": "听到“我说的是事实”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "建立可执行方案",
      "instruction": "遭遇“你还要不要继续？”的再次追问后，争取一个明确落点：“明确停止侮辱并在必要时离开对话”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "你就是没用"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "控制升级",
      "text": "我愿意讨论发生的事情，但‘你没用’不是对问题的描述。请把你不满的具体行为和影响说出来，我们才能谈解决办法。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "我说的是事实"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "寻找真实利益",
      "text": "你可以不同意我的处理方式，但不能用人格评价替代事实。我愿意核对具体记录；如果继续侮辱，我会暂停这次讨论。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "你还要不要继续？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "建立可执行方案",
      "text": "只要能回到具体问题，我们可以继续；如果继续人身攻击，我现在会结束对话，并在适当情况下通过正式渠道沟通。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "我说的是事实",
    "你还要不要继续？"
  ],
  "coach": {
    "focus": "拒绝人格攻击；对话安全与边界优先于强行说服对方。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
    "rubric": [
      {
        "name": "结构清楚",
        "weight": 25
      },
