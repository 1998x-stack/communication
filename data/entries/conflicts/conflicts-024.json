{
  "schemaVersion": 2,
  "id": "conflicts-024",
  "category": "conflicts",
  "title": "公司内部资源抢夺",
  "level": 24,
  "difficulty": "high",
  "background": "两个部门负责人为了预算互相指责。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "预算总额固定且不能满足全部诉求"
  ],
  "objective": "依据业务影响和风险建立排序",
  "method": "Principled Negotiation / BATNA",
  "pillars": [
    "控制升级",
    "寻找真实利益",
    "建立可执行方案"
  ],
  "steps": [
    {
      "name": "控制升级",
      "instruction": "开场先围绕已知事实“预算总额固定且不能满足全部诉求”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "寻找真实利益",
      "instruction": "听到“不给预算项目就死了”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "建立可执行方案",
      "instruction": "遭遇“有什么统一标准？”的再次追问后，争取一个明确落点：“依据业务影响和风险建立排序”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "我们比他们更重要"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "控制升级",
      "text": "预算总额固定，两边都重要，却不能全部满足。先停止“谁更重要”的互相评价，把项目影响和风险放在一张表里比较。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "不给预算项目就死了"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "寻找真实利益",
      "text": "你们担心拿不到预算项目会失败，我理解。但负责人需要看到如果减少投入会损失什么、哪些底线不能突破，以及是否可分阶段实施。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "有什么统一标准？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "建立可执行方案",
      "text": "建议用业务影响、合规安全、不可逆损失和交付时效作统一评分，公开假设与证据；最终由预算授权人决定并记录调整依据。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "不给预算项目就死了",
    "有什么统一标准？"
  ],
  "coach": {
    "focus": "稀缺预算按共同可解释标准排序，而不是部门权力争夺。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
    "rubric": [
      {
        "name": "结构清楚",
        "weight": 25
      },
