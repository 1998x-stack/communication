{
  "schemaVersion": 2,
  "id": "conflicts-025",
  "category": "conflicts",
  "title": "邻里赔偿争议",
  "level": 25,
  "difficulty": "high",
  "background": "楼上漏水造成家中家具受损。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "漏水来源尚未明确"
  ],
  "objective": "先留存记录并联系物业或专业鉴定",
  "method": "Principled Negotiation / BATNA",
  "pillars": [
    "控制升级",
    "寻找真实利益",
    "建立可执行方案"
  ],
  "steps": [
    {
      "name": "控制升级",
      "instruction": "开场先围绕已知事实“漏水来源尚未明确”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "寻找真实利益",
      "instruction": "听到“你有证据吗？”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "建立可执行方案",
      "instruction": "遭遇“怎么共同鉴定？”的再次追问后，争取一个明确落点：“先留存记录并联系物业或专业鉴定”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "这不是我的责任"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "控制升级",
      "text": "家具确实受损了，但漏水来源尚未查明，我不能现在就认定一定是楼上的责任。我们先记录损害和发生时间。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "你有证据吗？"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "寻找真实利益",
      "text": "证据需要共同核实。我会保留照片、维修记录和物业报修时间，也希望一起查看相关水管和建筑设施，避免误判。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "怎么共同鉴定？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "建立可执行方案",
      "text": "先联系物业检查，必要时请专业机构鉴定漏水来源与损失范围；责任确认后再讨论修复或赔偿，暂不进行人身指责。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "你有证据吗？",
    "怎么共同鉴定？"
  ],
  "coach": {
    "focus": "赔偿前先保全证据和专业鉴定，不抢先归责。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
    "rubric": [
      {
        "name": "结构清楚",
        "weight": 25
      },
