{
  "schemaVersion": 2,
  "id": "conflicts-028",
  "category": "conflicts",
  "title": "重大错误归责",
  "level": 28,
  "difficulty": "high",
  "background": "项目损失后各方都要求别人承担全部责任。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "目前缺少完整日志与一致的时间线"
  ],
  "objective": "先保全证据并启动独立责任核查",
  "method": "Principled Negotiation / BATNA",
  "pillars": [
    "控制升级",
    "寻找真实利益",
    "建立可执行方案"
  ],
  "steps": [
    {
      "name": "控制升级",
      "instruction": "开场先围绕已知事实“目前缺少完整日志与一致的时间线”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "寻找真实利益",
      "instruction": "听到“你们必须全赔”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "建立可执行方案",
      "instruction": "遭遇“先查哪些客观证据？”的再次追问后，争取一个明确落点：“先保全证据并启动独立责任核查”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "这就是你们的问题"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "控制升级",
      "text": "项目确实出现损失，但现在缺少完整日志和一致时间线，不能直接让任何一方承担全部责任。先把证据保存好。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "你们必须全赔"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "寻找真实利益",
      "text": "你们希望尽快明确赔偿范围，这可以理解，但责任比例需要基于决策、执行、控制措施和损失链条核查，不是靠谁先喊出来。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "先查哪些客观证据？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "建立可执行方案",
      "text": "建议独立小组保全记录、重建时间线并明确取证责任；核实后再协商各方责任与补救，争议较大时按合同和适用程序处理。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "你们必须全赔",
    "先查哪些客观证据？"
  ],
  "coach": {
    "focus": "重大损失优先证据保存和独立核查，不抢先承诺全部赔偿。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
