{
  "schemaVersion": 2,
  "id": "conflicts-029",
  "category": "conflicts",
  "title": "有权力差的施压",
  "level": 29,
  "difficulty": "high",
  "background": "权威人士要求你同意明显不公平的条款。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "条款包含重大单方违约责任"
  ],
  "objective": "拒绝当场签署并寻求独立审阅",
  "method": "Principled Negotiation / BATNA",
  "pillars": [
    "控制升级",
    "寻找真实利益",
    "建立可执行方案"
  ],
  "steps": [
    {
      "name": "控制升级",
      "instruction": "开场先围绕已知事实“条款包含重大单方违约责任”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "寻找真实利益",
      "instruction": "听到“你是不是不想合作？”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "建立可执行方案",
      "instruction": "遭遇“你需要什么审查时间？”的再次追问后，争取一个明确落点：“拒绝当场签署并寻求独立审阅”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "现在签了不就完了吗？"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "控制升级",
      "text": "这份条款包含重大的单方违约责任，我不能现场签署。需要先核对风险并获得独立审阅意见，才能作负责任的决定。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "你是不是不想合作？"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "寻找真实利益",
      "text": "希望合作不代表必须无条件接受条款。公平审查保护双方，特别是违约责任和退出条件需要明确对等。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "你需要什么审查时间？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "建立可执行方案",
      "text": "请给出完整可编辑文本和合理审查期限，我会与独立专业人士核对并提交修改建议；审阅前不签署，也不接受口头催签替代正式流程。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "你是不是不想合作？",
    "你需要什么审查时间？"
  ],
  "coach": {
    "focus": "权力不对等时守住审阅时间和独立专业意见的权利。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
