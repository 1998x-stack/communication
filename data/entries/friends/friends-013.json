{
  "schemaVersion": 2,
  "id": "friends-013",
  "category": "friends",
  "title": "双方社交频率不同",
  "level": 13,
  "difficulty": "medium",
  "background": "朋友希望每周固定聚会。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "你当前工作节奏较紧"
  ],
  "objective": "协商更适合双方的见面频率",
  "method": "积极倾听 / 边界表达",
  "pillars": [
    "真诚理解",
    "相互回应",
    "尊重分寸"
  ],
  "steps": [
    {
      "name": "真诚理解",
      "instruction": "开场先围绕已知事实“你当前工作节奏较紧”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "相互回应",
      "instruction": "听到“是不是有新朋友了？”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "尊重分寸",
      "instruction": "遭遇“我们怎么保持联系？”的再次追问后，争取一个明确落点：“协商更适合双方的见面频率”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "你变了以前不是这样"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "真诚理解",
      "text": "你想每周见面是因为珍惜联系，我也重视这段友情。但现在工作节奏紧，每周都聚我确实难保证。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "是不是有新朋友了？"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "相互回应",
      "text": "不是因为有了新朋友就把你放后面，而是我可支配时间变少了。减少频率不等于以后不关心你。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "我们怎么保持联系？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "尊重分寸",
      "text": "我们可以先试两三周见一次，平时遇到重要事直接联系；如果临时变动，我会早点说明，不再让你一直猜。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "是不是有新朋友了？",
    "我们怎么保持联系？"
  ],
  "coach": {
    "focus": "用可持续的联系频率替代勉强答应每周聚会。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
