{
  "schemaVersion": 2,
  "id": "leadership-020",
  "category": "leadership",
  "title": "团队士气低落",
  "level": 20,
  "difficulty": "medium",
  "background": "连续两个冲刺没有达到目标。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "计划与实际容量长期不匹配"
  ],
  "objective": "先缩减非关键目标并公布资源支持",
  "method": "SBI / 双向反馈",
  "pillars": [
    "期望明确",
    "安全表达",
    "具体反馈"
  ],
  "steps": [
    {
      "name": "期望明确",
      "instruction": "开场先围绕已知事实“计划与实际容量长期不匹配”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "安全表达",
      "instruction": "听到“又要打鸡血吗？”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "具体反馈",
      "instruction": "遭遇“下周究竟减什么？”的再次追问后，争取一个明确落点：“先缩减非关键目标并公布资源支持”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "大家已经很累了"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "期望明确",
      "text": "两个冲刺连续没达目标，大家确实很累。计划与实际容量长期不匹配，先要改计划，不是再要求大家用意志力补差。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "又要打鸡血吗？"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "安全表达",
      "text": "这次不会只讲鼓励的话。我们会公布哪些目标保留、哪些暂停，以及谁来帮忙清理阻塞，避免口号代替资源调整。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "下周究竟减什么？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "具体反馈",
      "text": "下周先砍掉低价值的非关键事项，给每项保留工作明确容量上限。我来和需求方沟通优先级，团队按实际完成率复盘。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "又要打鸡血吗？",
    "下周究竟减什么？"
  ],
  "coach": {
    "focus": "用减少承诺和实质资源支持回应士气问题。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
    "rubric": [
      {
        "name": "结构清楚",
        "weight": 25
      },
      {
        "name": "理解对方",
        "weight": 25
      },
      {
        "name": "坚定尊重",
        "weight": 25
      },
      {
        "name": "行动落点",
        "weight": 25
      }
    ]
  },
