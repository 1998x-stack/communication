{
  "schemaVersion": 2,
  "id": "leadership-025",
  "category": "leadership",
  "title": "高压时期防止过劳",
  "level": 25,
  "difficulty": "high",
  "background": "重要上线前员工连续加班。你是这次沟通的一方，不能预知对方后续的反问，需要在尊重与清晰之间作出选择。",
  "facts": [
    "两人已连续五天工作到深夜"
  ],
  "objective": "重排优先级并明确休息与值班安排",
  "method": "SBI / 双向反馈",
  "pillars": [
    "期望明确",
    "安全表达",
    "具体反馈"
  ],
  "steps": [
    {
      "name": "期望明确",
      "instruction": "开场先围绕已知事实“两人已连续五天工作到深夜”作清楚表达，避免猜测对方动机。"
    },
    {
      "name": "安全表达",
      "instruction": "听到“领导不是只要结果吗？”时，先识别顾虑，再坚持可验证事实或个人边界。"
    },
    {
      "name": "具体反馈",
      "instruction": "遭遇“谁负责删减范围？”的再次追问后，争取一个明确落点：“重排优先级并明确休息与值班安排”。"
    }
  ],
  "dialogue": [
    {
      "turn": 1,
      "role": "counterpart",
      "stage": "起始提问",
      "text": "不加班肯定做不完"
    },
    {
      "turn": 2,
      "role": "learner",
      "stage": "期望明确",
      "text": "两位同事连续五天工作到深夜，继续硬撑有健康和质量风险。上线任务要重新分优先级，而不是以无限加班作计划前提。",
      "isModel": true
    },
    {
      "turn": 3,
      "role": "counterpart",
      "stage": "第一轮反问",
      "text": "领导不是只要结果吗？"
    },
    {
      "turn": 4,
      "role": "learner",
      "stage": "安全表达",
      "text": "结果当然重要，但疲劳失误也会让上线失败。我们先确认关键链路的最低安全范围，非关键需求移出这次发布。",
      "isModel": true
    },
    {
      "turn": 5,
      "role": "counterpart",
      "stage": "第二轮追问",
      "text": "谁负责删减范围？"
    },
    {
      "turn": 6,
      "role": "learner",
      "stage": "具体反馈",
      "text": "由我负责和业务方砍范围，安排休息、交替值班和明确的应急联系人；任何安全关键项无法覆盖就升级调整上线决策。",
      "isModel": true
    }
  ],
  "pushbacks": [
    "领导不是只要结果吗？",
    "谁负责删减范围？"
  ],
  "coach": {
    "focus": "管理者承担删减范围的责任，不能把过劳包装成责任心。",
    "pitfalls": [
      "不要一开始就长篇解释，忽略对方真实关切。",
      "不要把事实、推测和个人感受混在一起。",
      "不要用虚假承诺或人格攻击换取表面同意。"
    ],
    "selfCheck": [
      "我是否先听懂对方的问题？",
      "我是否把事实和立场说得足够清楚？",
      "我是否回应了反问而不是机械背稿？",
      "我是否给出明确行动、边界或下一步？"
    ],
    "rubric": [
      {
        "name": "结构清楚",
        "weight": 25
      },
      {
        "name": "理解对方",
        "weight": 25
      },
      {
        "name": "坚定尊重",
        "weight": 25
      },
      {
        "name": "行动落点",
        "weight": 25
      }
    ]
  },
