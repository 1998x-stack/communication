{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Yanxi canonical independent case - v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "category",
    "title",
    "difficulty",
    "tags",
    "roundCount",
    "background",
    "facts",
    "objective",
    "dialogue"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 2
    },
    "difficulty": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "roundCount": {
      "type": "integer",
      "minimum": 1
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "level": {
      "type": "integer",
      "minimum": 1
    },
    "background": {
      "type": "string",
      "minLength": 10
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "objective": {
      "type": "string",
      "minLength": 4
    },
    "dialogue": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "turn",
          "role",
          "text"
        ],
        "properties": {
          "turn": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "enum": [
              "counterpart",
              "learner"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pillars": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "instruction"
        ]
      }
    },
    "coach": {
      "type": "object"
    },
    "safetyNote": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string",
      "format": "uri"
    }
  },
  "additionalProperties": true,
  "description": "Semantic invariants (dialogue.length = roundCount*2, role alternation, ID ownership, etc.) enforced by scripts/lib/metadata-v2.mjs"
}
